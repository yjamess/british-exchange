# Layer B — PostgreSQL observation spine
# Prefer cloud Supabase (Project Settings → Database → URI / Session pooler):
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Local Docker/Homebrew (optional):
# DATABASE_URL=postgresql://britain@127.0.0.1:5432/britain_exchange

# Without DATABASE_URL, FastAPI serves curated files from data/.
# Load cloud DB without a password via PostgREST (schema must already exist):
#   uv run python -m britain_exchange.load_ready --via-rest

# Supabase Storage archive — private bucket bx-data-archive
# uv run python -m britain_exchange.archive_data push-largest
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Preferred for archive push/pull (Project Settings → API → service_role):
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Web (also copy into web/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
