# Cloud completeness — Supabase is the live store (see AGENTS.md).
# PostgreSQL observation spine (Project Settings → Database → URI / Session pooler):
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Local Docker/Homebrew (optional for laptop-only experiments):
# DATABASE_URL=postgresql://britain@127.0.0.1:5432/britain_exchange

# Production / Railway refuse Ready series from local files (auto-on when RAILWAY_* is set):
# BX_REQUIRE_POSTGRES=1
# Local file fallback for Ready series is dev-only when BX_REQUIRE_POSTGRES is unset/0.

# Load cloud DB without a password via PostgREST (schema must already exist):
#   uv run python -m britain_exchange.load_ready --via-rest

# Supabase Storage — private bucket bx-data-archive (atlas, stations, map packs, raw)
# uv run python -m britain_exchange.archive_data push --keep-local data/energy/.../curated/atlas.json
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Preferred for archive push/pull (Project Settings → API → service_role):
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Web (also copy into web/.env.local) — points at FastAPI, which serves Postgres + /packs
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
